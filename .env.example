APP_NAME="Goldcrest Forex API"
APP_ENV=development
LOG_LEVEL=INFO
GOLDCREST_BIND_HOST=127.0.0.1
GOLDCREST_PORT=8090
DATABASE_PATH=./data/goldcrest_ai.sqlite3

# REQUIRED: replace the placeholder with a real random secret before starting the API.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Copy the generated value after API_KEY= . Do not keep the placeholder below.
API_KEY=PASTE_A_REAL_GENERATED_SECRET_HERE

LLAMA_BASE_URL=http://192.168.29.80:8080
# Leave empty to auto-select only when exactly one model is served.
LLAMA_MODEL_ID=
LLAMA_TIMEOUT_SECONDS=20
LLAMA_MAX_TOKENS=300
MAX_CANDLE_COUNT=500
MAX_SNAPSHOT_AGE_SECONDS=120

# Comma-separated browser origins allowed to call this API (never use '*').
GOLDCREST_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.29.80:5173,http://localhost:4173,http://127.0.0.1:4173,http://192.168.29.80:4173
