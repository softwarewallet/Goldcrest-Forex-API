APP_NAME="Goldcrest Forex API"
APP_ENV=development
LOG_LEVEL=INFO
GOLDCREST_BIND_HOST=127.0.0.1
GOLDCREST_PORT=8090
DATABASE_PATH=./data/goldcrest_ai.sqlite3

# DEVELOPMENT ONLY: short keys of at least 8 characters are accepted when APP_ENV=development.
# Example: API_KEY=GoldDev26
# Production requires a strong key of at least 32 characters.
API_KEY=GoldDev26

LLAMA_BASE_URL=http://192.168.29.80:8080
# Leave empty to auto-select only when exactly one model is served.
LLAMA_MODEL_ID=
LLAMA_TIMEOUT_SECONDS=20
LLAMA_MAX_TOKENS=300
MAX_CANDLE_COUNT=500
MAX_SNAPSHOT_AGE_SECONDS=120

# Comma-separated browser origins allowed to call this API (never use '*').
# Keep only origins you actually use; add the exact dashboard origin if its host/port differs.
GOLDCREST_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.29.80:5173,http://192.168.29.61:5173,http://localhost:4173,http://127.0.0.1:4173,http://192.168.29.80:4173,http://192.168.29.61:4173

# cTrader Open API credentials for historical RESEARCH ONLY.
# Fill these values in your local .env file; never commit the real .env file.
# This workflow is restricted to DEMO and does not place orders.
CTRADER_HOST=demo
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_ACCOUNT_ID=
